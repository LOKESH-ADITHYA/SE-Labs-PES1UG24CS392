@startuml UseCase_PublicBusLiveTracking
' ============================================================
' Lab 1 - UML Use-Case Diagram
' Problem Statement #24: Public Bus Live Tracking & Crowding Estimator
' SRN: PES1UG24CS392
' ============================================================

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 13
skinparam ArrowColor #37474F
skinparam ArrowFontSize 12
skinparam nodesep 22
skinparam ranksep 65
skinparam actor {
  BorderColor #1A4C8B
  BackgroundColor #E8F0FA
}
skinparam usecase {
  BorderColor #1A4C8B
  BackgroundColor #F5F9FF
  FontColor #14304F
}
skinparam rectangle {
  BorderColor #90A4AE
  FontColor #14304F
  FontStyle bold
}
left to right direction

' ---------- All actors, drawn on the left ----------
' Primary (human) actors
actor "Commuter"         as CM
actor "Fleet Controller" as FC
' Secondary (system / device) actors
actor "Onboard GPS Unit"           as GPS
actor "Ticketing / APC Sensor"     as TKT
actor "Push Notification\nService" as PNS

CM  -[hidden]down- FC
FC  -[hidden]down- GPS
GPS -[hidden]down- TKT
TKT -[hidden]down- PNS

rectangle "Public Bus Live Tracking & Crowding Estimator" {

  usecase "**UC-01**\nSearch Route / Stop"        as UC01
  usecase "**UC-02**\nView Live Bus\nLocation & ETA\n--\n//extension points//\nETA displayed" as UC02
  usecase "**UC-03**\nView Crowding Level"        as UC03
  usecase "**UC-04**\nSubscribe to\nArrival Alert" as UC04
  usecase "**UC-05**\nMonitor Fleet\nDashboard\n--\n//extension points//\nException flagged" as UC05
  usecase "**UC-06**\nDispatch Relief Bus"        as UC06
  usecase "**UC-07**\nCompute ETA"                as UC07
  usecase "**UC-08**\nEstimate\nCrowding Level"   as UC08
  usecase "**UC-09**\nIngest GPS\nTelemetry"      as UC09
  usecase "**UC-10**\nAuthenticate\nController"   as UC10
}

' ---------- Associations ----------
CM  --> UC02
FC  --> UC05
GPS --> UC09
TKT --> UC08
PNS --> UC04

' ---------- <<include>> relationships ----------
UC02 ..> UC01 : <<include>>
UC02 ..> UC07 : <<include>>
UC02 ..> UC03 : <<include>>
UC05 ..> UC10 : <<include>>

' ---------- <<extend>> relationships ----------
UC04 ..> UC02 : <<extend>>\n(ETA displayed)
UC06 ..> UC05 : <<extend>>\n(Exception flagged)

@enduml
