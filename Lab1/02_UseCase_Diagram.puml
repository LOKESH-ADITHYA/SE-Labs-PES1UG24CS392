@startuml UseCase_PublicBusLiveTracking
' ============================================================
' Lab 1 - UML Use-Case Diagram
' Problem Statement #24: Public Bus Live Tracking & Crowding Estimator
' SRN: PES1UG24CS392
' ============================================================

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 13
skinparam ArrowColor #37474F
skinparam ArrowFontSize 12
skinparam nodesep 22
skinparam ranksep 60
skinparam actor {
  BorderColor #1A4C8B
  BackgroundColor #E8F0FA
}
skinparam usecase {
  BorderColor #1A4C8B
  BackgroundColor #F5F9FF
  FontColor #14304F
}
skinparam rectangle {
  BorderColor #90A4AE
  FontColor #14304F
  FontStyle bold
}
left to right direction

' ---------- Primary (human) actors : left ----------
actor "Commuter"         as CM
actor "Fleet Controller" as FC

rectangle "Public Bus Live Tracking & Crowding Estimator" {

  usecase "Search Route / Stop"           as UC1
  usecase "View Live Bus\nLocation & ETA" as UC2
  usecase "View Crowding Level"           as UC3
  usecase "Subscribe to\nArrival Alert"   as UC4
  usecase "Monitor Fleet\nDashboard"      as UC5
  usecase "Dispatch Relief Bus"           as UC6

  usecase "Compute ETA"             as UC8
  usecase "Authenticate Controller" as UC10
  usecase "Ingest GPS Telemetry"    as UC7
  usecase "Estimate Crowding Level" as UC9
}

' ---------- Secondary / system actors : right ----------
actor "Onboard GPS Unit"           as GPS
actor "Ticketing / APC Sensor"     as TKT
actor "Push Notification\nService" as PNS

' ---------- Actor associations ----------
CM --> UC1
CM --> UC2
CM --> UC4
FC --> UC5
FC --> UC6

UC7 --> GPS
UC9 --> TKT
UC4 --> PNS

' ---------- <<include>> relationships ----------
UC2  ..> UC8  : <<include>>
UC2  ..> UC3  : <<include>>
UC5  ..> UC10 : <<include>>
UC8  ..> UC7  : <<include>>
UC3  ..> UC9  : <<include>>

' ---------- <<extend>> relationships ----------
UC4 ..> UC2 : <<extend>>
UC6 ..> UC5 : <<extend>>

legend right
  |= Notation |= Meaning |
  | <&arrow-right> solid | actor–use-case association |
  | ..> <<include>> | base use case **always** performs the included one |
  | ..> <<extend>> | extending use case runs **conditionally** on the base |
  ----
  **Key <<extend>> conditions**
  //Subscribe to Arrival Alert// — optional, while viewing a bus's live ETA.
  //Dispatch Relief Bus// — only when the dashboard flags a delayed
  or overcrowded bus.
endlegend

@enduml
